# Copy to .env and fill in. Start the server with: uv run --env-file .env uvicorn main:app ...
# Never commit .env (it is gitignored).

# DeepSeek direct API (primary model deepseek-v4-flash)
DEEPSEEK_API_KEY=
# OpenRouter (most of the model pool)
OPENROUTER_API_KEY=
# Artificial Analysis API (only used by the perfrouter data tooling, not by the proxy)
AA_API_KEY=

# Optional providers (see config.yaml `providers:`)
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
